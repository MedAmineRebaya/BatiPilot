# Supabase — Project Settings → API
# Copy this file to .env (gitignored) and fill in real values there.
# Never put real keys in this .example file — it's committed to git.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...              # "anon" / "publishable" key — safe for the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # "service_role" / "secret" key — SERVER ONLY, never in the browser
